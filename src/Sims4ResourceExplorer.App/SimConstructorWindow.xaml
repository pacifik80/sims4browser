<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sims4ResourceExplorer.App.SimConstructorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sim Character Constructor"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <NavigationView
            x:Name="SectionNav"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            CompactPaneLength="56"
            SelectionChanged="SectionNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Genetics" Tag="Genetics" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Outfits" Tag="Outfits">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Animation" Tag="Animation">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Border x:Name="PreviewSurface" />
            <StackPanel x:Name="PreviewPlaceholder"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        MaxWidth="640">
                <TextBlock Text="{Binding SeedDisplayName}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding OutfitPartCountText}"
                           Opacity="0.85"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SyntheticFullInstanceHex}"
                           Opacity="0.6"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SeedSummary}"
                           Opacity="0.7"
                           TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,16,0,0"
                        MaxWidth="640"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding AssetGraphStatus}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding BodyCandidatesSummary}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.85"
                                   TextWrapping="NoWrap" />
                        <Expander Header="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <TextBlock Text="{Binding AssetGraphDiagnostics}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="WrapWholeWords" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>
                <TextBlock Text="3D viewport lands in P0.4c — this panel currently surfaces the resolved synthetic asset graph for diagnostic purposes."
                           Opacity="0.5"
                           FontStyle="Italic"
                           Margin="0,8,0,0"
                           TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel x:Name="KnobPanel" Padding="16" Spacing="16">
                    <TextBlock x:Name="KnobSectionTitle"
                               Text="Genetics"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Base" FontWeight="SemiBold" />
                            <ComboBox Header="Age"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableAges}"
                                      SelectedItem="{Binding SelectedAge, Mode=TwoWay}" />
                            <ComboBox Header="Gender"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableGenders}"
                                      SelectedItem="{Binding SelectedGender, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="KnobSectionStub"
                               Text="Skintone, body and face morph sliders land in P1. CAS part pickers (hair, top, bottom, shoes, accessories, makeup) land in P2. Idle clip controls land in P3."
                               Opacity="0.6"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
