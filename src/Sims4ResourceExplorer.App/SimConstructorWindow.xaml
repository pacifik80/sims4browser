<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sims4ResourceExplorer.App.SimConstructorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sims4ResourceExplorer.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sim Character Constructor"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <converters:UintArgbToBrushConverter x:Key="SwatchBrush" />
            <converters:ZeroToVisibilityConverter x:Key="ZeroVisible" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisible" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <NavigationView
            x:Name="SectionNav"
            Grid.Column="0"
            HorizontalAlignment="Left"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="200"
            CompactPaneLength="56"
            SelectionChanged="SectionNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Genetics" Tag="Genetics" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Outfits" Tag="Outfits">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Animation" Tag="Animation">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid x:Name="PreviewSurface" />

            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#80000000"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisible}}">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing IsActive="True" Width="48" Height="48" Foreground="White" />
                    <TextBlock Text="{Binding SceneStatus}"
                               Foreground="White"
                               TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="320" />
                </StackPanel>
            </Border>

            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="#CC101418"
                    Padding="12,8">
                <TextBlock Text="{Binding SceneStatus}"
                           Foreground="#F0F0F0"
                           TextWrapping="WrapWholeWords" />
            </Border>
        </Grid>

        <Border Grid.Column="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel x:Name="KnobPanel" Padding="16" Spacing="16">
                    <TextBlock x:Name="KnobSectionTitle"
                               Text="Genetics"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Base" FontWeight="SemiBold" />
                            <ComboBox Header="Age"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableAges}"
                                      SelectedItem="{Binding SelectedAge, Mode=TwoWay}" />
                            <ComboBox Header="Gender"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableGenders}"
                                      SelectedItem="{Binding SelectedGender, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Skintone" FontWeight="SemiBold" />
                            <Button x:Name="SkintonePickerButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{Binding SelectedSkintone.SwatchArgb, Converter={StaticResource SwatchBrush}}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedSkintone.DisplayName, FallbackValue=Select skintone…}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE70D;"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Opacity="0.6" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout x:Name="SkintonePickerFlyout" Placement="Bottom">
                                        <GridView x:Name="SkintonePickerGrid"
                                                  ItemsSource="{Binding AvailableSkintones}"
                                                  SelectedItem="{Binding SelectedSkintone, Mode=TwoWay}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="SkintonePickerGrid_ItemClick"
                                                  Width="360"
                                                  MaxHeight="420">
                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Margin" Value="2" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="32"
                                                          Height="32"
                                                          ToolTipService.ToolTip="{Binding DisplayName}">
                                                        <Border CornerRadius="4"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                Background="{Binding SwatchArgb, Converter={StaticResource SwatchBrush}}" />
                                                        <Path Visibility="{Binding Instance, Converter={StaticResource ZeroVisible}}"
                                                              Stroke="#E81123"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Data="M 6,6 L 26,26 M 26,6 L 6,26" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Expander Header="Skin textures" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Each layer: optional picker + 0..1 power. 0 hides the layer, 1 = full strength."
                                       Opacity="0.6" FontSize="11" TextWrapping="WrapWholeWords" />

                            <!-- Slider-only layers (defaults driven by skintone) -->
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base skin" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding BaseSkinAlpha, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding BaseSkinAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skintone shift (brightness)" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SkintoneShift, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="-0.1" Maximum="0.1" StepFrequency="0.01" Value="{Binding SkintoneShift, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Text="Body type (skin definition)" FontWeight="SemiBold" Opacity="0.85" Margin="0,6,0,0" />
                            <TextBlock Text="Blends the game's physique skin-detail rows. Mesh shape is a separate track." FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heavy" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhysiqueHeavy, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding PhysiqueHeavy, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fit" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhysiqueFit, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding PhysiqueFit, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lean" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhysiqueLean, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding PhysiqueLean, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bony" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhysiqueBony, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding PhysiqueBony, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Detail (neutral)" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DetailNeutralAlpha, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding DetailNeutralAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Detail overlay" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DetailOverlayAlpha, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding DetailOverlayAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hue shift (Pass 3)" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Pass3HueAlpha, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding Pass3HueAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tone face overlay" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding ToneFaceOverlayAlpha, Mode=OneWay}" Opacity="0.7" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding ToneFaceOverlayAlpha, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Face CAS layers — picker + slider per slot -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />
                            <TextBlock Text="Face CAS overlays" FontWeight="SemiBold" Opacity="0.85" />

                            <StackPanel Spacing="4">
                                <ComboBox Header="EyeColor" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableEyeColors}"
                                          SelectedItem="{Binding SelectedEyeColor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding EyeColorAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox Header="Brows" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableBrows}"
                                          SelectedItem="{Binding SelectedBrows, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding BrowsAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox Header="Lipstick" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableLipsticks}"
                                          SelectedItem="{Binding SelectedLipstick, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding LipstickAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox Header="Eyeshadow" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableEyeshadows}"
                                          SelectedItem="{Binding SelectedEyeshadow, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding EyeshadowAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox Header="Eyeliner" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableEyeliners}"
                                          SelectedItem="{Binding SelectedEyeliner, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding EyelinerAlpha, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox Header="Blush" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableBlushes}"
                                          SelectedItem="{Binding SelectedBlush, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding BlushAlpha, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Viewport" FontWeight="SemiBold" />
                            <ComboBox Header="Render mode"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableRenderModes}"
                                      SelectedItem="{Binding SelectedRenderMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SeedDisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding OutfitPartCountText}"
                                       Opacity="0.85"
                                       FontSize="12" />
                            <TextBlock Text="{Binding SyntheticFullInstanceHex}"
                                       Opacity="0.6"
                                       FontFamily="Consolas"
                                       FontSize="11" />
                            <TextBlock Text="{Binding AssetGraphStatus}"
                                       Opacity="0.85"
                                       FontSize="12"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Expander Header="Body candidates" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding BodyCandidatesSummary}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.85"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Expander>

                    <Button Click="DumpScene_Click"
                            HorizontalAlignment="Stretch"
                            Content="Dump current scene to disk" />

                    <Expander Header="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AssetGraphDiagnostics}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.7"
                                       TextWrapping="WrapWholeWords" />
                        </ScrollViewer>
                    </Expander>

                    <TextBlock x:Name="KnobSectionStub"
                               Text="Skintone, body and face morph sliders land in P1. CAS part pickers (hair, top, bottom, shoes, accessories, makeup) land in P2. Idle clip controls land in P3."
                               Opacity="0.5"
                               FontStyle="Italic"
                               FontSize="11"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
